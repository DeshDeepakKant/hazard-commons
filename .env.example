# Copy to .env (git-ignored). Never commit real values.

# --- 0G Compute Router (OpenAI-compatible) ---
ZG_ROUTER_BASE_URL=https://router-api.0g.ai/v1
ZG_ROUTER_API_KEY=sk-...
ZG_MODEL=0gm-1.0-35b-a3b

# --- 0G Galileo testnet (throwaway keys only) ---
ZG_RPC_URL=https://evmrpc-testnet.0g.ai
ZG_CHAIN_ID=16602
DEPLOYER_PRIVATE_KEY=0x...
OPERATOR_ZIPKART_PRIVATE_KEY=0x...
OPERATOR_MINUTEMART_PRIVATE_KEY=0x...
OPERATOR_DASHKIRANA_PRIVATE_KEY=0x...

# --- 0G Storage ---
ZG_STORAGE_INDEXER=https://indexer-storage-testnet-turbo.0g.ai
# which key pays for storage uploads (defaults to deployer)
STORAGE_PRIVATE_KEY=

# --- modes ---
# DEMO=1 is set by scripts/run_demo.sh and refuses MOCK_BRAIN.
DEMO=0
# Dev-only physics testing: fake brain. Prints a loud banner. Never in demo/video.
MOCK_BRAIN=0
