<?xml version="1.0" encoding="UTF-8"?>
<!-- Hazard Commons background traffic. Paths are relative to this file. Loaded by traffic/bridge.py (libsumo). -->
<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">
    <input>
        <net-file value="out/bandra.net.xml.gz"/>
        <additional-files value="vtypes.add.xml"/>
        <route-files value="out/car.rou.xml.gz,out/motorcycle.rou.xml.gz,out/auto.rou.xml.gz,out/bus.rou.xml.gz,out/ped.rou.xml.gz"/>
    </input>
    <time>
        <begin value="0"/>
        <step-length value="0.1"/>
    </time>
    <processing>
        <ignore-route-errors value="true"/>
        <time-to-teleport value="90"/>
        <time-to-teleport.disconnected value="1"/>
        <max-depart-delay value="30"/>
        <max-num-vehicles value="160"/>
        <collision.action value="warn"/>
        <collision.check-junctions value="false"/>
        <pedestrian.model value="striping"/>
        <default.speeddev value="0.1"/>
    </processing>
    <routing>
        <device.rerouting.probability value="1"/>
        <device.rerouting.period value="60"/>
        <device.rerouting.adaptation-interval value="10"/>
    </routing>
    <report>
        <no-step-log value="true"/>
        <no-warnings value="true"/>
        <duration-log.disable value="true"/>
    </report>
</configuration>
