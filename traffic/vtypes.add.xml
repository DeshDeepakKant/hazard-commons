<?xml version="1.0" encoding="UTF-8"?>
<!-- Hazard Commons vehicle/person types for Bandra West (left-hand traffic).
     Mixed Indian traffic: tight gaps (minGap), sloppy lane keeping (sublane model via lateralResolution in sumocfg is off for perf). -->
<additional xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/additional_file.xsd">
    <vType id="car" vClass="passenger" guiShape="passenger" length="4.2" width="1.7" minGap="1.5"
           maxSpeed="16.7" accel="2.2" decel="4.5" sigma="0.6" speedFactor="normc(0.8,0.15,0.4,1.1)" color="0.85,0.85,0.85"/>
    <vType id="motorcycle" vClass="motorcycle" guiShape="motorcycle" length="2.0" width="0.8" minGap="0.8"
           maxSpeed="16.7" accel="3.0" decel="6.0" sigma="0.7" speedFactor="normc(0.9,0.15,0.5,1.2)" color="0.2,0.2,0.9"/>
    <vType id="bus" vClass="bus" guiShape="bus" length="11.0" width="2.5" minGap="2.0"
           maxSpeed="12.5" accel="1.2" decel="4.0" sigma="0.5" speedFactor="normc(0.8,0.1,0.5,1.0)" color="0.8,0.1,0.1"/>
    <!-- auto-rickshaw: three-wheeler, small and slow. Shares passenger roads. -->
    <vType id="auto_rickshaw" vClass="passenger" guiShape="passenger/hatchback" length="2.6" width="1.3" minGap="1.0"
           maxSpeed="13.0" accel="1.5" decel="4.0" sigma="0.7" speedFactor="normc(0.85,0.15,0.5,1.0)" color="0.1,0.6,0.1"/>
    <vType id="pedestrian" vClass="pedestrian" guiShape="pedestrian" length="0.3" width="0.5" minGap="0.25"
           maxSpeed="1.6" speedFactor="normc(0.9,0.15,0.5,1.3)" color="0.9,0.7,0.5"/>
    <!-- our delivery rovers, injected each step via moveToXY (keepRoute=2). vClass delivery is allowed on most urban roads. -->
    <vType id="delivery_bot" vClass="delivery" guiShape="delivery" length="1.0" width="0.7" minGap="0.5"
           maxSpeed="4.0" accel="2.0" decel="4.0" sigma="0" color="1,0.42,0.1"/>
</additional>
